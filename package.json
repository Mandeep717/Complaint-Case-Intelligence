{
  "name": "ps26264-complaint-intelligence",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace server run build && npm --workspace web run build",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke.ps1",
    "seed": "npm --workspace server run seed",
    "start": "npm --workspace server start"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
