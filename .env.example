# Local development uses Node's built-in SQLite adapter; persisted database file.
DATABASE_PATH=./data/ps26264.db
PORT=4000
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-before-any-shared-deployment
JWT_EXPIRES_IN=8h

# Optional embedding service: OpenAI-compatible embeddings endpoint.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
VECTOR_INDEX_NAME=complaint_embeddings
SEMANTIC_TOP_K=8
SEARCH_SIMILARITY_THRESHOLD=0.35
SIMILARITY_THRESHOLD=0.35

# Optional OpenAI-compatible chat endpoint (can point to Ollama's /v1).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
AI_TIMEOUT_MS=12000
ANALYSIS_RETRY_LIMIT=3
NOTIFICATION_SCHEDULE_MINUTES=60
